{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "defaultThinkingLevel": "high",
  "transport": "auto",
  "compaction": {
    "enabled": false
  },
  "defaultTools": [
    "+codemode"
  ],
  "hideThinkingBlock": true,
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:pi-web-access",
    {
      "source": "npm:pi-markdown-preview",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:pi-simplify",
    {
      "source": "npm:pi-lens",
      "extensions": [
        "-dist/index.js"
      ]
    },
    "npm:@tintinweb/pi-subagents",
    {
      "source": "npm:pi-undo-redo",
      "extensions": [
        "-src/extension.ts"
      ]
    },
    "npm:pi-timing",
    "npm:@tmustier/pi-usage-extension",
    "npm:betterwright",
    "../../../.nvm/versions/node/v24.12.0/lib/node_modules/@jmfederico/pi-web/dist/pi-packages/relays",
    "npm:pi-subagents",
    "npm:@xynogen/pix-core"
  ],
  "quietStartup": true
}
