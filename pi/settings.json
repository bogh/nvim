{
  "lastChangelogVersion": "0.84.2",
  "theme": "dark",
  "defaultProvider": "routera-anthropic",
  "defaultModel": "anthropic/claude-fable-5",
  "defaultThinkingLevel": "high",
  "tuiMode": "regular",
  "transport": "auto",
  "compaction": {
    "enabled": true
  },
  "hideThinkingBlock": false,
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    {
      "source": "npm:pi-markdown-preview",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:pi-simplify",
    {
      "source": "npm:pi-lens",
      "extensions": [
        "-dist/index.js"
      ]
    },
    "npm:@tintinweb/pi-subagents",
    {
      "source": "npm:pi-undo-redo",
      "extensions": [
        "-src/extension.ts"
      ]
    },
    "npm:pi-timing",
    "npm:@tmustier/pi-usage-extension",
    "npm:betterwright"
  ]
}
